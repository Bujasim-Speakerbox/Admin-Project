{
  "entities": {
    "Workspace": {
      "title": "Workspace",
      "description": "Shared multi-device workspace root holding ownership and authorized member email list.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name of the shared workspace."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the workspace creator/owner."
        },
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified email address of the workspace owner."
        },
        "memberEmails": {
          "type": "array",
          "description": "Bounded list (max 20) of authorized Google account emails allowed to read and edit this workspace."
        },
        "seeded": {
          "type": "boolean",
          "description": "Whether initial seed data has been populated."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the workspace was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last update."
        }
      },
      "required": [
        "name",
        "ownerUid",
        "ownerEmail",
        "memberEmails",
        "seeded",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceSecurity": {
      "title": "WorkspaceSecurity",
      "description": "Isolated security configuration storing the admin passcode for locked sections.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "passcode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "description": "Admin passcode protecting Client Movement and Device Allocation views."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceId",
        "ownerUid",
        "passcode",
        "createdAt",
        "updatedAt"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin team member managing assigned social media and branding projects.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "memberEmails": {
          "type": "array",
          "description": "Bounded list (max 20) of authorized member emails."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 500
        },
        "color": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20,
          "pattern": "^#[0-9a-fA-F]{3,8}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "ownerUid",
        "memberEmails",
        "name",
        "email",
        "department",
        "color",
        "createdAt",
        "updatedAt"
      ]
    },
    "Project": {
