  },
  "firestore": {
    "/workspaces/{workspaceId}": {
      "schema": {
        "$ref": "#/entities/Workspace"
      },
      "description": "Shared workspace root containing owner identity and authorized member emails."
    },
    "/workspaces/{workspaceId}/security/{securityId}": {
      "schema": {
        "$ref": "#/entities/WorkspaceSecurity"
      },
      "description": "Workspace admin passcode configuration isolated from general collections."
    },
    "/workspaces/{workspaceId}/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "Admins assigned projects in this workspace."
    },
    "/workspaces/{workspaceId}/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/Project"
      },
      "description": "Social media and branding projects in this workspace."
    },
    "/workspaces/{workspaceId}/designers/{designerId}": {
      "schema": {
        "$ref": "#/entities/Designer"
      },
      "description": "Designers allocated to admins in this workspace."
    },
    "/workspaces/{workspaceId}/movements/{movementId}": {
      "schema": {
        "$ref": "#/entities/ClientMovement"
      },
      "description": "Client onboarded and exit logs in this workspace."
    },
    "/workspaces/{workspaceId}/devices/{deviceId}": {
      "schema": {
        "$ref": "#/entities/DeviceAllocation"
      },
      "description": "Company devices and SIM lines allocated to admins in this workspace."
    }
  }
}
